# Ticketmaster API Configuration
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
TICKETMASTER_API_URL=https://app.ticketmaster.com/discovery/v2

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ticketmaster_dashboard?schema=public"
POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/ticketmaster_dashboard?schema=public&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://username:password@localhost:5432/ticketmaster_dashboard?schema=public"

# Next.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Optional: For development
NODE_ENV=development
